# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (M0) ---
DATABASE_URL="mysql://root:password@127.0.0.1:3307/ipam_alumni"

# --- Auth.js (M1) ---
AUTH_SECRET=

# --- Twilio Verify — OTP (M1) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Twilio Messaging — bulk SMS/WhatsApp broadcast (M7) ---
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=

# --- SendGrid — transactional + broadcast email (M7) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- Firebase — push notifications only (M4) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Stripe — international payments (M6) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Flutterwave — Sierra Leone local payments (M6) ---
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# --- AWS S3 — media storage (M9, or earlier if used in dev) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# --- Zoom Server-to-Server OAuth (M8) ---
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Google Calendar / Meet API (M8) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
