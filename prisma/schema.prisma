// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ALUMNI
  STUDENT
  EMPLOYER
  PUBLIC_VISITOR
  ADMIN
  MODERATOR
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PhysicalCardStatus {
  REQUESTED
  PRINTING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum AnnouncementType {
  ANNOUNCEMENT
  EVENT
  DEADLINE
  NEWS
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

model User {
  id              String    @id @default(cuid())
  email           String?   @unique
  phone           String    @unique
  studentId       String?   @unique
  passwordHash    String?
  role            Role      @default(PUBLIC_VISITOR)
  status          UserStatus @default(PENDING_VERIFICATION)
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  alumniProfile           AlumniProfile?
  supportTickets          SupportTicket[]
  virtualIdCard           VirtualIdCard?
  physicalCardRequests    PhysicalCardRequest[]
  announcementDismissals  AnnouncementDismissal[]
  deviceTokens            DeviceToken[]

  @@index([role])
}

model AlumniProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String
  age                Int?
  sex                Sex
  gender             String?
  religion           String?
  photoUrl           String?
  residentialAddress String?
  workAddress        String?
  programOfStudy     String?
  degreeType         String?
  yearFrom           Int?
  yearTo             Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SupportTicket {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  message   String       @db.Text
  status    TicketStatus @default(OPEN)
  adminNote String?      @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
  @@index([status])
}

model Announcement {
  id        String           @id @default(cuid())
  title     String
  body      String           @db.Text
  type      AnnouncementType @default(ANNOUNCEMENT)
  isActive  Boolean          @default(true)
  startsAt  DateTime         @default(now())
  endsAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  dismissals AnnouncementDismissal[]

  @@index([isActive])
}

model AnnouncementDismissal {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  dismissedAt    DateTime     @default(now())

  @@unique([userId, announcementId])
}

model AdBanner {
  id              String    @id @default(cuid())
  title           String
  imageUrl        String
  linkUrl         String
  isActive        Boolean   @default(true)
  startsAt        DateTime  @default(now())
  endsAt          DateTime?
  impressionCount Int       @default(0)
  clickCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive])
}

model DeviceToken {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String         @unique
  platform  DevicePlatform
  createdAt DateTime       @default(now())

  @@index([userId])
}

model VirtualIdCard {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardNumber String   @unique
  issuedAt   DateTime @default(now())
}

model PhysicalCardRequest {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryAddress String             @db.Text
  status          PhysicalCardStatus @default(REQUESTED)
  paymentVerified Boolean            @default(false)
  adminNote       String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}
